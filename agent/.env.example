# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- LLM (DeepSeek V4.1 Flash, OpenAI-совместимый API с tool calling) ---
# Получите ключ на https://platform.deepseek.com/api_keys и задайте его локально.
# Пустой LLM_API_KEY = демо-режим без LLM (детерминированная заглушка).
# Для локальных серверов без ключа (Ollama, vLLM) укажите любую непустую строку.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Необязательно: часть моделей (например, reasoning) не принимает temperature — тогда не задавайте.
# LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- Агент ---
# Сколько раундов «LLM -> инструменты» допускается на одно сообщение пользователя.
AGENT_MAX_STEPS=12
# Город вылета по умолчанию (id из каталога). Агент называет его допущением.
DEFAULT_ORIGIN=moscow

# --- Сервер ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
